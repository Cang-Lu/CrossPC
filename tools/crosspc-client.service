# systemd **user** service for the CrossPC client (autostart the client on Debian)
#
# Install:
#   mkdir -p ~/.config/systemd/user
#   cp tools/crosspc-client.service ~/.config/systemd/user/
#   # adjust the path/IP/resolution as described in the comments below
#   systemctl --user daemon-reload
#   systemctl --user enable --now crosspc-client
#   systemctl --user status crosspc-client
#   journalctl --user -u crosspc-client -f        # follow the logs
#
# Important: a user service does not inherit the graphical session environment
# variables (X11/Wayland) by default, so run this once:
#   systemctl --user import-environment DISPLAY WAYLAND_DISPLAY XAUTHORITY
# and consider adding that line to ~/.bash_profile or ~/.xprofile as well so it
# takes effect automatically at boot.
#
# Note: if the client uses uinput (Wayland), CROSSPC_SCREEN must hold the
# **exact** resolution, otherwise the absolute coordinates will be offset.

[Unit]
Description=CrossPC client -- receive another computer's mouse and keyboard over the LAN
Documentation=file:%h/CrossPC/README.md
# Connect once the graphical session is up (X11 injection fails without one)
After=graphical-session.target network-online.target
PartOf=graphical-session.target
Wants=network-online.target

[Service]
Type=simple
# >>> edit these three lines as needed >>>
WorkingDirectory=%h/CrossPC
Environment=CROSSPC_SCREEN=2560x1440
# An X11 desktop is usually just :0; on Wayland leave this empty and set
# WAYLAND_DISPLAY properly
Environment=DISPLAY=:0
# <<< edit these lines as needed <<<

# Without --host the client finds the server over UDP; pin the IP for stability
ExecStart=/usr/bin/python3 -m crosspc client --host 192.168.1.10

# Reconnect automatically after a drop (the client reconnects internally too;
# this is one more safety net)
Restart=always
RestartSec=3

# uinput needs access to /dev/uinput; after running tools/install_linux.sh and
# logging back in, the input group can already access it, so relaxing the
# permissions is normally unnecessary.
# If you still get permission errors, uncomment the two lines below (slightly
# less secure):
#SupplementaryGroups=input
#DeviceAllow=/dev/uinput rw

[Install]
WantedBy=default.target
